# ── Required in production ────────────────────────────────────────────
# Derives the Ed25519 certificate-signing key (HKDF). Required in production.
# Generate: openssl rand -base64 48
STAGECRAFT_SECRET=

# ── Database (libSQL / Turso). Omit for a local SQLite file in .data/ ──
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── Behaviour ─────────────────────────────────────────────────────────
# "off" hides the persona switcher and enforces student-email sign-in.
STAGECRAFT_DEMO=on
# "off" skips demo seeding on an empty database.
STAGECRAFT_SEED=on
# First sign-up with this email becomes admin (only while no admin exists).
BOOTSTRAP_ADMIN_EMAIL=
# Set to 1 only behind a proxy you control, so rate limits can trust X-Forwarded-For.
TRUST_PROXY=0
# Comma-separated email domains allowed to sign in when demo mode is off.
ALLOWED_EMAIL_DOMAINS=ds.study.iitm.ac.in,es.study.iitm.ac.in
# Public URL used in certificate QR codes and LinkedIn links.
NEXT_PUBLIC_SITE_URL=https://stagecraft.example.com
