# ── Required in production ────────────────────────────────────────────
# Signs session cookies AND derives the Ed25519 certificate key (HKDF).
# Generate: openssl rand -base64 48
STAGECRAFT_SECRET=

# ── Database (libSQL / Turso). Omit for a local SQLite file in .data/ ──
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── Behaviour ─────────────────────────────────────────────────────────
# "off" hides the persona switcher and enforces student-email sign-in.
STAGECRAFT_DEMO=on
# "off" skips demo seeding on an empty database.
STAGECRAFT_SEED=on
# Comma-separated email domains allowed to sign in when demo mode is off.
ALLOWED_EMAIL_DOMAINS=ds.study.iitm.ac.in,es.study.iitm.ac.in
# Public URL used in certificate QR codes and LinkedIn links.
NEXT_PUBLIC_SITE_URL=https://stagecraft.example.com
